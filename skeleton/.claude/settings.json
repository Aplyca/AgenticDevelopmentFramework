{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__get_session",
      "mcp__ccd_session_mgmt__set_session_title",
      "Bash(rg *)",
      "Bash(glab *)",
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "ask": [
      "Bash(git config *)",
      "Bash(git push *--tags*)",
      "Bash(glab mr merge *)",
      "Bash(glab mr accept *)",
      "Bash(glab mr approve *)",
      "Bash(glab mr revoke *)",
      "Bash(glab mr unapprove *)",
      "Bash(glab release *)",
      "Bash(glab repo delete *)",
      "Bash(glab variable *)",
      "Bash(glab var *)",
      "Bash(glab securefile *)",
      "Bash(glab auth *)",
      "Bash(glab token *)",
      "Bash(glab api *-X *)",
      "Bash(glab api *--method *)",
      "Bash(glab api *-f *)",
      "Bash(glab api *-F *)",
      "Bash(glab api *--field *)",
      "Bash(glab api *--raw-field *)",
      "Bash(glab api *--form *)",
      "Bash(glab api *--input *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method *)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field *)",
      "Bash(gh api *--raw-field *)",
      "Bash(gh api *--input *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-state.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-state.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-title.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/triage-first.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-hub.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/careful-paths.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/triage-first.sh"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_directory__change_directory",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approve-worktree-move.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approve-status-move.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-env-declared.sh"
          }
        ]
      }
    ]
  }
}
