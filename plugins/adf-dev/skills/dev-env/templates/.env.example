# Every variable the local environment reads, by name, with no real value. `make env` copies this
# file to .env: Compose reads that to fill ${...} in compose.yaml, and the app reads it when it
# runs on the host (`make native`). .env stays out of git. A value may use the variables above it.

# The Compose project. Empty: the checkout's folder names it, so each worktree has its own stack.
COMPOSE_PROJECT_NAME=

# Host ports. Empty: Docker picks a free one each time the service starts (`make urls`). Set one
# to pin it — for an app that must know its own URL.
APP_PORT=
REDIS_PORT=

# CUSTOMIZE: credentials and settings, names only — e.g.
# MAILCHIMP_API_KEY=

# The app on the host reaches the backing services on their published ports. `make native`
# exports each *_PORT before it starts the app.
REDIS_URL=redis://localhost:${REDIS_PORT}
