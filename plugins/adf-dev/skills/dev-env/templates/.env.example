# Every variable the local environment reads, by name, with no real value. `make env` copies this
# file to .env: Compose reads that to fill ${...} in compose.yaml, and the app reads it when it
# runs on the host (native mode). .env stays out of git. A value may use the variables above it.

# Where the app runs in this checkout: docker (ops/make/docker.mk, the whole stack in Docker) or
# native (ops/make/native.mk, the app on the host). Empty: DEFAULT_MODE in the Makefile.
DEV_MODE=

# The Compose project. Empty: the checkout's folder names it, so each worktree has its own stack.
COMPOSE_PROJECT_NAME=

# Host ports. Empty: Docker picks a free one each time the service starts (`make urls`). Set one
# to pin it — for an app that must know its own URL, or a service you run on the host yourself.
APP_PORT=
REDIS_PORT=

# CUSTOMIZE: credentials and settings, names only — e.g.
# MAILCHIMP_API_KEY=

# The app on the host reaches the backing services on their published ports. In native mode, `make
# up` exports each *_PORT before it starts the app.
REDIS_URL=redis://localhost:${REDIS_PORT}
