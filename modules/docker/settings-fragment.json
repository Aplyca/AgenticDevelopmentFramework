      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker * rm *)",
      "Bash(docker * prune)",
      "Bash(docker * prune *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",
      "Bash(docker run *)",
      "Bash(docker push *)",
      "Bash(docker login)",
      "Bash(docker login *)",
      "Bash(docker inspect *)",
      "Bash(docker compose config)",
      "Bash(docker *exec *env*)",
