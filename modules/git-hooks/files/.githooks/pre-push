#!/bin/sh
# pre-push: refuse pushes to protected branches, then run the fast checks.
# Enable once per clone: git config core.hooksPath .githooks
#
# Only the fast layers belong here. Integration, end-to-end, and visual tests run in CI — a slow
# hook is a hook people learn to push past.

# CUSTOMIZE: the fast checks, run in order from the repository root. Empty skips them.
FAST_CHECKS=""
# e.g. FAST_CHECKS="npm run lint
# npx tsc --noEmit
# npm run test:unit"
# With the docker module, the make tasks, which run where the local mode runs its tools, so the host
# needs nothing installed (in Docker mode they start the tools container themselves; tier= comes
# with the unit module):
# FAST_CHECKS="make lint
# make typecheck
# make test tier=smoke"

root="$(git rev-parse --show-toplevel)" || exit 1

PROTECTED_BRANCHES="main master"
# One source of truth with the Claude Code guard hook, when it is installed. The file is read as
# data, never run, as the hooks read it: the last PROTECTED_BRANCHES="…" line wins.
if [ -f "$root/.claude/hooks/config.sh" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in PROTECTED_BRANCHES=*) ;; *) continue ;; esac
    value="${line#*=}"
    case "$value" in
      \"*) value="${value#\"}" && value="${value%%\"*}" ;;
      \'*) value="${value#\'}" && value="${value%%\'*}" ;;
      *) value="${value%%[[:space:]]*}" ;;
    esac
    PROTECTED_BRANCHES="$value"
  done <"$root/.claude/hooks/config.sh"
fi

fail() {
  printf '\n  pre-push: %s\n\n' "$1" >&2
  exit 1
}

# Read the refs being pushed from stdin rather than the current branch, so that
# `git push origin HEAD:main` and `git push origin feature:main` are caught too.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  branch="${remote_ref#refs/heads/}"
  # Each protected name is a glob: "release/*" covers every release branch.
  set -f
  for pattern in $PROTECTED_BRANCHES; do
    case "$branch" in
      $pattern) fail "pushing directly to '$branch' is not allowed. Open a pull request instead." ;;
    esac
  done
  set +f
done

if [ -n "$FAST_CHECKS" ]; then
  cd "$root" || exit 1
  printf '%s\n' "$FAST_CHECKS" | while IFS= read -r check; do
    [ -n "$check" ] || continue
    printf '  pre-push: %s\n' "$check"
    sh -c "$check" </dev/null || exit 1
  done || fail "a check failed. Fix it before pushing — don't bypass the hook."
fi

exit 0
